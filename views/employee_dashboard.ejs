<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Mahasiswa</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <a class="navbar-brand" href="#">Kehadiran Mahasiswa</a>
            <div class="d-flex">
                <span class="navbar-text text-white me-3">Halo, <%= user.name %>!</span>
                <a href="/logout" class="btn btn-outline-light btn-sm">Logout</a>
            </div>
        </div>
    </nav>

    <div class="container mt-5">
        <% if (error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>
        <div class="row">
            <div class="col-md-4">
                <div class="card shadow-sm text-center p-4">
                    <h4>Absensi Hari Ini</h4>
                    <p class="text-muted"><%= new Date().toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></p>
                    
                    <% if (todayAttendance.length === 0) { %>
                        <div class="alert alert-secondary">Scan QR sesi kehadiran untuk clock-in.</div>
                    <% } else { %>
                        <% todayAttendance.forEach(function(record) { %>
                            <div class="alert <%= record.clock_out ? 'alert-success' : 'alert-info' %> text-start">
                                <strong><%= record.subject_name || 'Mata pelajaran' %></strong><br>
                                Masuk: <%= record.clock_in || '-' %> | Pulang: <%= record.clock_out || 'Belum' %>
                            </div>
                        <% }) %>
                        <div class="alert alert-secondary mb-0">Scan QR mata pelajaran lain atau scan kembali untuk clock-out.</div>
                    <% } %>
                </div>
                <div class="card shadow-sm text-center p-4 mt-4">
                    <h5>Scan QR Kehadiran</h5>
                    <p class="text-muted small">Scan QR sesi yang ditampilkan admin untuk mencatat kehadiran Anda.</p>
                    <div id="qr-reader" class="mb-3"></div>
                    <form action="/employee/scan-qr" method="POST" id="scan-form">
                        <input type="hidden" name="qrToken" id="qr-token" required>
                        <button type="submit" class="btn btn-primary w-100" id="scan-submit" disabled>Scan QR untuk Absen</button>
                    </form>
                </div>
            </div>
            
            <div class="col-md-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">Riwayat Kehadiran</h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped">
                                <thead>
                                    <tr>
                                        <th>Tanggal</th>
                                        <th>Mata Pelajaran</th>
                                        <th>Jam Masuk</th>
                                        <th>Jam Pulang</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (history.length > 0) { %>
                                        <% history.forEach(function(record) { %>
                                            <tr>
                                                <td><%= record.date %></td>
                                                <td><%= record.subject_name || '-' %></td>
                                                <td><%= record.clock_in || '-' %></td>
                                                <td><%= record.clock_out || '-' %></td>
                                                <td><span class="badge bg-success"><%= record.status %></span></td>
                                            </tr>
                                        <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="5" class="text-center">Belum ada riwayat absen.</td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>
    <script>
        const tokenInput = document.getElementById('qr-token');
        const submitButton = document.getElementById('scan-submit');
        const scanner = new Html5QrcodeScanner('qr-reader', { fps: 10, qrbox: 220 });
        scanner.render((decodedText) => {
            tokenInput.value = decodedText;
            submitButton.disabled = false;
            scanner.clear();
            document.getElementById('scan-form').submit();
        }, () => {});
    </script>
</body>
</html>
